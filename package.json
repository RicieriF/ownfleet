{
  "name": "ownfleet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "yarn workspace @ownfleet/api dev",
    "dev:web": "yarn workspace @ownfleet/web dev",
    "build:api": "yarn workspace @ownfleet/api build",
    "build:web": "yarn workspace @ownfleet/web build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
